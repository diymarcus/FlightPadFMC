<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/connection_mode"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rg_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rb_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_discovery"/>

        <RadioButton
            android:id="@+id/rb_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manual_ip"/>
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_ip_address"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/et_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.0.x"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_port"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/et_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="8765"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <!-- Sound Toggle Checkbox -->
    <CheckBox
        android:id="@+id/cb_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔊 Button Press Sound"
        android:textSize="14sp"
        android:checked="true"
        android:layout_marginBottom="8dp"/>

    <!-- Haptic Feedback Toggle Checkbox -->
    <CheckBox
        android:id="@+id/cb_haptic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📳 Haptic Feedback (Vibration)"
        android:textSize="14sp"
        android:checked="true"
        android:layout_marginBottom="16dp"/>

    <!-- CDU Side (v0.4.1) — default side applied on every connect;
         swiping the display switches sides temporarily without
         changing this setting -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CDU Side"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rg_side"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rb_capt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Captain CDU"/>

        <RadioButton
            android:id="@+id/rb_fo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="First Officer CDU"/>
    </RadioGroup>

    <!-- Info Text (COMMENTED OUT - May be needed later)
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ Use calibration if buttons don't align on your screen"
        android:textColor="#ff8c00"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>
    -->

</LinearLayout>
