<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FlightPadFMC Server must be running on the MSFS PC."
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connection Mode"
        android:layout_marginBottom="4dp"/>

    <RadioGroup
        android:id="@+id/rg_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rb_auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto (mDNS)"
            android:layout_marginEnd="24dp"/>

        <RadioButton
            android:id="@+id/rb_manual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual IP"/>

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server IP Address (MSFS PC)"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/et_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.0.x"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server Port (default 8765)"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/et_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="8765"
        android:inputType="number"
        android:layout_marginBottom="16dp"/>

    <!-- Calibrate buttons hidden — annunciator positions baked into MCDUView
         defaults after the 2026-05-01 rework. To restore: change
         android:visibility="gone" to "visible" on both buttons. R.id refs
         and the MainActivity click handlers stay live either way. -->
    <Button
        android:id="@+id/btn_calibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📐 Calibrate Touch Areas (Full)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#ff8c00"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btn_calibrate_leds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Calibrate LEDs Only"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#ff8c00"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <CheckBox
        android:id="@+id/cb_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Button Press Sound"
        android:textSize="14sp"
        android:checked="true"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cb_haptic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Haptic Feedback (Vibration)"
        android:textSize="14sp"
        android:checked="true"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
